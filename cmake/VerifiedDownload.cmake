# Keep interrupted transfers out of the verified cache. Identity lives with
# the dependency owner (Common for typography, RunnerScope for the broker).
function(runnerscope_download url checksum destination)
    if(EXISTS "${destination}")
        file(SHA256 "${destination}" actual)
        if(actual STREQUAL checksum)
            return()
        endif()
    endif()
    set(partial "${destination}.partial")
    file(DOWNLOAD "${url}" "${partial}" TLS_VERIFY ON
        TIMEOUT 300 INACTIVITY_TIMEOUT 30 STATUS result)
    list(GET result 0 code)
    if(NOT code EQUAL 0)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Unable to download ${url}: ${result}")
    endif()
    file(SHA256 "${partial}" actual)
    if(NOT actual STREQUAL checksum)
        file(REMOVE "${partial}")
        message(FATAL_ERROR "Archive checksum mismatch: ${url}")
    endif()
    file(RENAME "${partial}" "${destination}")
endfunction()
