# Core contracts deliberately build without desktop dependencies or downloads.
function(runnerscope_test name source library)
    set(target "runnerscope-${name}")
    add_executable(${target} "${CMAKE_CURRENT_SOURCE_DIR}/tests/${source}")
    target_link_libraries(${target} PRIVATE ${library})
    runnerscope_warnings(${target})
    add_test(NAME ${target} COMMAND ${target} ${ARGN})
    set_tests_properties(${target} PROPERTIES TIMEOUT 60)
endfunction()

runnerscope_test(config-test runner_config_test.c runnerscope_core)
runnerscope_test(json-test json_test.c runnerscope_core)
target_include_directories(runnerscope-json-test PRIVATE "${CMAKE_CURRENT_SOURCE_DIR}/third_party/cjson")
runnerscope_test(github-test github_test.c runnerscope_core)
runnerscope_test(github-auth-test github_auth_test.c runnerscope_core)
runnerscope_test(ui-contract-test ui_contract_test.c runnerscope_ui_contract)
runnerscope_test(ui-failure-semantics-test ui_failure_semantics_test.c runnerscope_ui_contract)

if(UNIX AND GIT_FOUND)
    find_program(RUNNERSCOPE_BASH bash REQUIRED)
    add_test(NAME runnerscope-release-state-test
        COMMAND "${RUNNERSCOPE_BASH}" "${CMAKE_CURRENT_SOURCE_DIR}/tests/release_state_test.sh")
    set_tests_properties(runnerscope-release-state-test PROPERTIES TIMEOUT 30)
endif()

if(RUNNERSCOPE_BUILD_DESKTOP)
    add_test(NAME runnerscope-native-self-test COMMAND runnerscope --self-test)
    set_tests_properties(runnerscope-native-self-test PROPERTIES TIMEOUT 60)
    if(WIN32)
        set(platform_library runnerscope_windows_platform)
        runnerscope_test(windows-config-store-test windows_config_store_test.c ${platform_library})
    else()
        set(platform_library runnerscope_linux_platform)
        runnerscope_test(linux-storage-test linux_storage_test.c ${platform_library})
        runnerscope_test(linux-services-test linux_services_test.c ${platform_library})
    endif()
    runnerscope_test(http-policy-test http_policy_test.c ${platform_library})
    add_executable(runnerscope-github-auth-fixture tests/github_auth_fixture.c)
    runnerscope_test(github-auth-process-test github_auth_process_test.c ${platform_library}
        $<TARGET_FILE:runnerscope-github-auth-fixture>)
    set_tests_properties(runnerscope-github-auth-process-test PROPERTIES TIMEOUT 15)
endif()
