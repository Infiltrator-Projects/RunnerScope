#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --builddirectory=build-debian -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	dh_auto_build --builddirectory=build-debian
	python3 -m py_compile runnerscope.py

override_dh_auto_test:
	build-debian/runnerscope-native --self-test
	python3 tests/test_native_bridge.py build-debian/runnerscope-native
	RUNNERSCOPE_NATIVE_HELPER="$(CURDIR)/build-debian/runnerscope-native" python3 runnerscope.py --self-test

override_dh_auto_install:
	DESTDIR="$(CURDIR)/debian/infiltrator-runner-monitor" cmake --install build-debian --prefix /usr
	install -D -m 0644 runnerscope.py "$(CURDIR)/debian/infiltrator-runner-monitor/usr/lib/runnerscope/runnerscope.py"
	install -D -m 0755 packaging/runnerscope "$(CURDIR)/debian/infiltrator-runner-monitor/usr/bin/runnerscope"
	install -D -m 0644 packaging/runnerscope.desktop "$(CURDIR)/debian/infiltrator-runner-monitor/usr/share/applications/runnerscope.desktop"
	install -D -m 0644 packaging/runnerscope.svg "$(CURDIR)/debian/infiltrator-runner-monitor/usr/share/icons/hicolor/scalable/apps/runnerscope.svg"
	install -D -m 0644 packaging/runnerscope.png "$(CURDIR)/debian/infiltrator-runner-monitor/usr/share/icons/hicolor/128x128/apps/runnerscope.png"
	install -D -m 0644 README.md "$(CURDIR)/debian/infiltrator-runner-monitor/usr/share/doc/infiltrator-runner-monitor/README.md"
