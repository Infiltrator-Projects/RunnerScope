#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --builddirectory=build-debian -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	dh_auto_build --builddirectory=build-debian

override_dh_auto_test:
ifeq (,$(filter nocheck,$(DEB_BUILD_OPTIONS)))
	ctest --test-dir build-debian --output-on-failure
endif

override_dh_auto_install:
	DESTDIR="$(CURDIR)/debian/runnerscope" cmake --install build-debian --prefix /usr
	install -D -m 0644 packaging/runnerscope.png "$(CURDIR)/debian/runnerscope/usr/share/app-install/icons/runnerscope.png"
	install -D -m 0644 README.md "$(CURDIR)/debian/runnerscope/usr/share/doc/runnerscope/README.md"

# Preserve the verified upstream sign-in executable byte for byte.
override_dh_strip:
	dh_strip -X/runnerscope/gh
