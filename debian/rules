#!/usr/bin/make -f
export DEB_BUILD_MAINT_OPTIONS = hardening=+all

%:
	dh $@

override_dh_auto_configure:
	dh_auto_configure --builddirectory=build-debian -- -DCMAKE_BUILD_TYPE=Release

override_dh_auto_build:
	dh_auto_build --builddirectory=build-debian

override_dh_auto_test:
	build-debian/runnerscope --self-test

override_dh_auto_install:
	DESTDIR="$(CURDIR)/debian/runnerscope" cmake --install build-debian --prefix /usr
